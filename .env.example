# All variables are OPTIONAL. The UI runs fully on bundled demo/replay data without them.
# Copy to .env.local to enable live Pyth Lazer quotes in the dashboard top bar.

# Pyth Lazer access token (server-side only; never expose via NEXT_PUBLIC_*).
PYTH_API_KEY=

# Optional overrides for the Pyth Lazer client.
# PYTH_STREAM_CHANNEL=fixed_rate@200ms
# PYTH_METADATA_SERVICE_URL=
# PYTH_PRICE_SERVICE_URL=

# Optional overrides for /api/oracle/primary (defaults to ADA/USD).
# PYTH_PRIMARY_SYMBOL_QUERY=ADA/USD
# PYTH_PRIMARY_SYMBOL=ADA/USD
# PYTH_PRIMARY_FEED_ID=pyth-ada-usd
# PYTH_PRIMARY_ASSET_TYPE=crypto
# PYTH_PRIMARY_PRICE_FEED_ID=
